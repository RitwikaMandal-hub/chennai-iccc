# Copy to .env.development (local) and point at your running services.
# Leave all of these unset for a production build to get the self-contained demo mode.
VITE_API_URL=http://localhost:5000
VITE_AI_URL=http://localhost:8100
VITE_SOCKET_URL=http://localhost:5000
# Force demo mode even when the URLs above are set:
# VITE_DEMO_MODE=true
